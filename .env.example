# Server
PORT=4173
NODE_ENV=development
STORAGE_DRIVER=json
# For Postgres:
# STORAGE_DRIVER=postgres
DATABASE_URL=postgres://flowpilot:flowpilot-dev@localhost:5432/flowpilot
PGSSL=disable
APP_ENCRYPTION_KEY=replace-with-a-long-random-secret
WORKER_ENABLED=true
WORKER_INTERVAL_MS=250
TRUST_PROXY=false
HTTP_ACCESS_LOG=true

# Abuse protection / observability
API_RATE_MAX=300
AUTH_RATE_MAX=10
AUTH_RATE_WINDOW_MS=900000
WEBHOOK_RATE_MAX=600
# If set, /api/metrics requires Authorization: Bearer <token>.
# Without it, metrics are only exposed to loopback requests.
METRICS_TOKEN=

# Meta platform
META_GRAPH_VERSION=v26.0
PUBLIC_BASE_URL=

# Instagram Business Login (recommended for new Instagram DM integrations)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_WEBHOOK_SECRET=
INSTAGRAM_OAUTH_REDIRECT_URI=http://localhost:4173/api/oauth/instagram/callback
INSTAGRAM_OAUTH_SCOPES=instagram_business_basic,instagram_business_manage_messages,instagram_business_manage_comments
INSTAGRAM_WEBHOOK_FIELDS=messages,message_edit,message_reactions,messaging_seen,comments

# Facebook/Meta Login remains used for WhatsApp/Messenger.
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_OAUTH_REDIRECT_URI=http://localhost:4173/api/oauth/meta/callback
META_OAUTH_SCOPES=
# Conservative default used by the compliance guard; change only after verifying current provider policy.
META_CUSTOMER_CARE_WINDOW_HOURS=24

# Provider adapter fallbacks / local development only
META_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_API_BASE=https://graph.instagram.com

# Never commit real credentials. Use a secret manager in production.

# Messenger / Telegram
MESSENGER_PAGE_ID=
TELEGRAM_BOT_TOKEN=

# Optional OpenAI-compatible AI provider. Without these, FlowPilot uses its local deterministic AI fallback.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# External HTTP action safety
# Keep false in production unless the deployment intentionally needs private-network callbacks.
ALLOW_PRIVATE_HTTP_ACTIONS=false

# Stripe subscriptions (optional until commercial launch)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
BILLING_RETURN_BASE_URL=
