NODE_ENV=production
PORT=10000
TRUST_PROXY=true
HTTP_ACCESS_LOG=true

# Private single-user mode
PERSONAL_MODE=true
SETUP_MODE=true
PERSONAL_EMAIL=YOUR_PRIVATE_LOGIN_EMAIL
PERSONAL_PASSWORD=GENERATE_A_STRONG_UNIQUE_PASSWORD_AT_LEAST_16_CHARS
PERSONAL_NAME=Administrador
PERSONAL_WORKSPACE_NAME=Meu Instagram
SEED_DEMO=false

# Production persistence
STORAGE_DRIVER=postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
PGSSL=require
APP_ENCRYPTION_KEY=GENERATE_AT_LEAST_32_RANDOM_BYTES

# Public HTTPS origin. On Render this can be omitted; RENDER_EXTERNAL_HOSTNAME is used automatically.
PUBLIC_BASE_URL=

# Instagram Business Login. Setup mode lets the app boot before these are filled.
META_GRAPH_VERSION=v26.0
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_WEBHOOK_SECRET=
INSTAGRAM_OAUTH_REDIRECT_URI=
INSTAGRAM_OAUTH_SCOPES=instagram_business_basic,instagram_business_manage_messages,instagram_business_manage_comments
INSTAGRAM_WEBHOOK_FIELDS=messages,message_edit,message_reactions,messaging_seen,comments
META_WEBHOOK_VERIFY_TOKEN=GENERATE_A_RANDOM_VERIFY_TOKEN

# Worker / protection
WORKER_ENABLED=true
WORKER_INTERVAL_MS=250
API_RATE_MAX=300
AUTH_RATE_MAX=10
AUTH_RATE_WINDOW_MS=900000
WEBHOOK_RATE_MAX=600
META_CUSTOMER_CARE_WINDOW_HOURS=24
ALLOW_PRIVATE_HTTP_ACTIONS=false

# Optional
METRICS_TOKEN=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
